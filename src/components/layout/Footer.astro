---
import { navItems, socialLinks } from '../../data/navigation';
import ResumeButton from '../ui/ResumeButton.astro';
---

<footer class="relative border-t" style="border-color: rgb(var(--color-border)); background-color: rgb(var(--color-bg-secondary));">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <!-- Resume CTA -->
    <div class="text-center mb-12 pb-12 border-b" style="border-color: rgb(var(--color-border));">
      <p class="text-lg font-medium mb-4" style="color: rgb(var(--color-text-muted));">
        Interested in learning more about my experience?
      </p>
      <div class="flex justify-center">
        <ResumeButton size="md" />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-cyan-500 flex items-center justify-center text-white font-bold text-sm">
            SK
          </div>
          <span class="text-lg font-semibold" style="color: rgb(var(--color-text));">
            Sai<span class="gradient-text">Khandavilli</span>
          </span>
        </div>
        <p class="text-sm leading-relaxed" style="color: rgb(var(--color-text-muted));">
          Senior Full Stack & AI Engineer building intelligent software that scales.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4 gradient-text">
          Quick Links
        </h3>
        <nav class="grid grid-cols-2 gap-2" aria-label="Footer navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="text-sm py-1 transition-colors duration-200 hover:text-violet-400"
              style="color: rgb(var(--color-text-muted));"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4 gradient-text">
          Connect
        </h3>
        <div class="flex flex-col gap-3">
          <a
            href={`mailto:${socialLinks.email}`}
            class="flex items-center gap-3 text-sm transition-colors duration-200 hover:text-violet-400"
            style="color: rgb(var(--color-text-muted));"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            {socialLinks.email}
          </a>
          <a
            href={socialLinks.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-sm transition-colors duration-200 hover:text-violet-400"
            style="color: rgb(var(--color-text-muted));"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a
            href={socialLinks.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-sm transition-colors duration-200 hover:text-violet-400"
            style="color: rgb(var(--color-text-muted));"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t flex flex-col sm:flex-row items-center justify-between gap-4" style="border-color: rgb(var(--color-border));">
      <p class="text-xs" style="color: rgb(var(--color-text-muted));">
        &copy; {new Date().getFullYear()} Sai Sri Rama Khandavilli. All rights reserved.
      </p>
      <p class="text-xs flex items-center gap-1.5" style="color: rgb(var(--color-text-muted));">
        Built with
        <svg class="w-4 h-4 text-violet-400" viewBox="0 0 128 128" fill="currentColor"><path d="M81.504 9.465c.973 1.207 1.469 2.836 2.457 6.09l21.656 71.136a90.079 90.079 0 0 0-25.89-8.174L65.629 30.429a.832.832 0 0 0-.798-.602.832.832 0 0 0-.799.602L50.25 78.517a90.104 90.104 0 0 0-25.89 8.174L46.015 15.555c.988-3.254 1.484-4.883 2.457-6.09a8 8 0 0 1 3.29-2.452C53.313 6.3 55.027 6.3 58.453 6.3h11.07c3.426 0 5.14 0 6.69.713a8 8 0 0 1 3.291 2.452Z"/><path d="M91.747 97.86a53.714 53.714 0 0 0-7.037-4.773c-1.637-.926-2.456-1.39-3.373-1.193a2.5 2.5 0 0 0-.878.427c-.734.59-.96 1.553-1.413 3.48l-.248 1.058c-.404 1.718-.606 2.577-1.093 3.14a3 3 0 0 1-1.135.867c-.695.316-1.574.227-3.333.048a57.48 57.48 0 0 0-9.474-.395 57.48 57.48 0 0 0-9.474.395c-1.759.179-2.638.268-3.333-.048a3 3 0 0 1-1.135-.868c-.487-.562-.689-1.421-1.093-3.14l-.248-1.057c-.453-1.927-.68-2.89-1.413-3.48a2.5 2.5 0 0 0-.878-.427c-.917-.197-1.736.267-3.373 1.193a53.711 53.711 0 0 0-7.037 4.773C28.732 107.693 24 113.487 24 121.7h80c0-8.213-4.732-14.007-12.253-23.84Z"/></svg>
        Astro +
        <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12.001,4.8c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 C13.666,10.618,15.027,12,18.001,12c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C16.337,6.182,14.976,4.8,12.001,4.8z M6.001,12c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 c1.177,1.194,2.538,2.576,5.512,2.576c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C10.337,13.382,8.976,12,6.001,12z"/></svg>
        Tailwind
      </p>
    </div>
  </div>
</footer>
