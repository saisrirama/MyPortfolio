---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'center' } = Astro.props;
const alignClasses = align === 'center' ? 'text-center' : 'text-left';
---

<div class:list={['mb-12 md:mb-16', alignClasses]}>
  <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
    <span class="gradient-text">{title}</span>
  </h2>
  {subtitle && (
    <p class="text-base md:text-lg max-w-2xl leading-relaxed" style={`color: rgb(var(--color-text-muted)); ${align === 'center' ? 'margin-left: auto; margin-right: auto;' : ''}`}>
      {subtitle}
    </p>
  )}
</div>
