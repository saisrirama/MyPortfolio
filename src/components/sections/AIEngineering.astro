---
import SectionHeading from '../ui/SectionHeading.astro';

const expertise = [
  'Agentic AI Workflows', 'LangGraph Orchestration', 'LLM Integrations',
  'Retrieval-Augmented Generation', 'Prompt Engineering', 'Structured Outputs (Pydantic)',
  'AI Evaluation & Observability', 'Vector Databases', 'Multi-Agent Systems', 'AI-Powered Automation',
];
---

<section id="ai-engineering" class="relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-violet-500/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"></div>

  <div class="section-container relative z-10">
    <SectionHeading
      title="AI Engineering"
      subtitle="I specialize in building production-ready AI systems that combine deterministic software engineering with probabilistic AI models."
    />

    <div class="max-w-3xl mx-auto text-center mb-12 reveal">
      <p class="text-base leading-relaxed" style="color: rgb(var(--color-text-muted));">
        My approach focuses on <span class="text-violet-400 font-medium">reliability</span>, <span class="text-cyan-400 font-medium">traceability</span>, and <span class="text-emerald-400 font-medium">measurable business outcomes</span> rather than experimentation alone.
      </p>
    </div>

    <!-- Expertise grid -->
    <div class="flex flex-wrap justify-center gap-3 mb-16 reveal">
      {expertise.map((item) => (
        <span class="tech-badge text-sm px-4 py-2 bg-violet-500/5 border-violet-500/20 hover:bg-violet-500/15">
          {item}
        </span>
      ))}
    </div>

    <!-- Architecture Diagrams -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">

      <!-- RAG Pipeline -->
      <div class="card p-6 md:p-8 reveal">
        <h3 class="text-lg font-bold mb-6 text-center" style="color: rgb(var(--color-text));">
          RAG Pipeline Architecture
        </h3>
        <div class="overflow-x-auto w-full pb-2 -mx-2 px-2 sm:mx-0 sm:px-0">
          <svg viewBox="0 0 400 280" class="w-full min-w-[450px]" xmlns="http://www.w3.org/2000/svg">
            <!-- Document -->
          <rect x="20" y="20" width="80" height="50" rx="8" fill="rgb(139 92 246 / 0.15)" stroke="rgb(139 92 246 / 0.4)" stroke-width="1.5"/>
          <text x="60" y="45" text-anchor="middle" fill="rgb(139 92 246)" font-size="10" font-weight="600" font-family="Inter, sans-serif">Documents</text>

          <!-- Arrow -->
          <line x1="100" y1="45" x2="140" y2="45" stroke="rgb(139 92 246 / 0.4)" stroke-width="1.5" marker-end="url(#arrowViolet)"/>

          <!-- Chunking -->
          <rect x="140" y="20" width="80" height="50" rx="8" fill="rgb(6 182 212 / 0.15)" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5"/>
          <text x="180" y="41" text-anchor="middle" fill="rgb(6 182 212)" font-size="10" font-weight="600" font-family="Inter, sans-serif">Chunking</text>
          <text x="180" y="53" text-anchor="middle" fill="rgb(6 182 212 / 0.7)" font-size="8" font-family="Inter, sans-serif">& Processing</text>

          <!-- Arrow -->
          <line x1="220" y1="45" x2="260" y2="45" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5" marker-end="url(#arrowCyan)"/>

          <!-- Embeddings -->
          <rect x="260" y="20" width="80" height="50" rx="8" fill="rgb(139 92 246 / 0.15)" stroke="rgb(139 92 246 / 0.4)" stroke-width="1.5"/>
          <text x="300" y="41" text-anchor="middle" fill="rgb(139 92 246)" font-size="10" font-weight="600" font-family="Inter, sans-serif">Vector</text>
          <text x="300" y="53" text-anchor="middle" fill="rgb(139 92 246 / 0.7)" font-size="8" font-family="Inter, sans-serif">Embeddings</text>

          <!-- Arrow down -->
          <line x1="300" y1="70" x2="300" y2="110" stroke="rgb(139 92 246 / 0.4)" stroke-width="1.5" marker-end="url(#arrowViolet)"/>

          <!-- Vector DB -->
          <rect x="240" y="110" width="120" height="50" rx="8" fill="rgb(16 185 129 / 0.15)" stroke="rgb(16 185 129 / 0.4)" stroke-width="1.5"/>
          <text x="300" y="131" text-anchor="middle" fill="rgb(16 185 129)" font-size="10" font-weight="600" font-family="Inter, sans-serif">Vector</text>
          <text x="300" y="143" text-anchor="middle" fill="rgb(16 185 129 / 0.7)" font-size="8" font-family="Inter, sans-serif">Database</text>

          <!-- Query flow -->
          <rect x="20" y="120" width="80" height="50" rx="8" fill="rgb(251 191 36 / 0.15)" stroke="rgb(251 191 36 / 0.4)" stroke-width="1.5"/>
          <text x="60" y="141" text-anchor="middle" fill="rgb(251 191 36)" font-size="10" font-weight="600" font-family="Inter, sans-serif">User</text>
          <text x="60" y="153" text-anchor="middle" fill="rgb(251 191 36 / 0.7)" font-size="8" font-family="Inter, sans-serif">Query</text>

          <!-- Arrow -->
          <line x1="100" y1="145" x2="140" y2="145" stroke="rgb(251 191 36 / 0.4)" stroke-width="1.5" marker-end="url(#arrowGold)"/>

          <!-- Semantic Search -->
          <rect x="140" y="110" width="80" height="50" rx="8" fill="rgb(6 182 212 / 0.15)" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5"/>
          <text x="180" y="131" text-anchor="middle" fill="rgb(6 182 212)" font-size="10" font-weight="600" font-family="Inter, sans-serif">Semantic</text>
          <text x="180" y="143" text-anchor="middle" fill="rgb(6 182 212 / 0.7)" font-size="8" font-family="Inter, sans-serif">Search</text>

          <!-- Arrow -->
          <line x1="220" y1="135" x2="240" y2="135" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5" marker-end="url(#arrowCyan)"/>

          <!-- Arrow down from semantic search -->
          <line x1="180" y1="160" x2="180" y2="200" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5" marker-end="url(#arrowCyan)"/>

          <!-- LLM -->
          <rect x="120" y="200" width="120" height="55" rx="8" fill="rgb(139 92 246 / 0.2)" stroke="rgb(139 92 246 / 0.5)" stroke-width="2"/>
          <text x="180" y="224" text-anchor="middle" fill="rgb(139 92 246)" font-size="12" font-weight="700" font-family="Inter, sans-serif">LLM</text>
          <text x="180" y="238" text-anchor="middle" fill="rgb(139 92 246 / 0.7)" font-size="8" font-family="Inter, sans-serif">Context + Generation</text>

          <!-- Arrow to Response -->
          <line x1="240" y1="228" x2="280" y2="228" stroke="rgb(16 185 129 / 0.4)" stroke-width="1.5" marker-end="url(#arrowGreen)"/>

          <!-- Response -->
          <rect x="280" y="200" width="100" height="55" rx="8" fill="rgb(16 185 129 / 0.15)" stroke="rgb(16 185 129 / 0.4)" stroke-width="1.5"/>
          <text x="330" y="224" text-anchor="middle" fill="rgb(16 185 129)" font-size="10" font-weight="600" font-family="Inter, sans-serif">Citation-backed</text>
          <text x="330" y="238" text-anchor="middle" fill="rgb(16 185 129 / 0.7)" font-size="8" font-family="Inter, sans-serif">Response</text>

          <!-- Arrow markers -->
          <defs>
            <marker id="arrowViolet" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="rgb(139 92 246 / 0.6)"/></marker>
            <marker id="arrowCyan" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="rgb(6 182 212 / 0.6)"/></marker>
            <marker id="arrowGold" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="rgb(251 191 36 / 0.6)"/></marker>
            <marker id="arrowGreen" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="rgb(16 185 129 / 0.6)"/></marker>
          </defs>
        </svg>
        </div>
      </div>

      <!-- Agent Workflow -->
      <div class="card p-6 md:p-8 reveal delay-200">
        <h3 class="text-lg font-bold mb-6 text-center" style="color: rgb(var(--color-text));">
          Agent Orchestration Workflow
        </h3>
        <div class="overflow-x-auto w-full pb-2 -mx-2 px-2 sm:mx-0 sm:px-0">
          <svg viewBox="0 0 400 280" class="w-full min-w-[450px]" xmlns="http://www.w3.org/2000/svg">
            <!-- User Input -->
          <rect x="140" y="10" width="120" height="45" rx="8" fill="rgb(251 191 36 / 0.15)" stroke="rgb(251 191 36 / 0.4)" stroke-width="1.5"/>
          <text x="200" y="37" text-anchor="middle" fill="rgb(251 191 36)" font-size="11" font-weight="600" font-family="Inter, sans-serif">User Input</text>

          <!-- Arrow down -->
          <line x1="200" y1="55" x2="200" y2="85" stroke="rgb(139 92 246 / 0.4)" stroke-width="1.5" marker-end="url(#arrowViolet2)"/>

          <!-- Orchestrator -->
          <rect x="120" y="85" width="160" height="50" rx="10" fill="rgb(139 92 246 / 0.2)" stroke="rgb(139 92 246 / 0.5)" stroke-width="2"/>
          <text x="200" y="107" text-anchor="middle" fill="rgb(139 92 246)" font-size="12" font-weight="700" font-family="Inter, sans-serif">LangGraph</text>
          <text x="200" y="121" text-anchor="middle" fill="rgb(139 92 246 / 0.7)" font-size="8" font-family="Inter, sans-serif">Orchestrator</text>

          <!-- Arrows to agents -->
          <line x1="140" y1="135" x2="60" y2="170" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5" marker-end="url(#arrowCyan2)"/>
          <line x1="200" y1="135" x2="200" y2="170" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5" marker-end="url(#arrowCyan2)"/>
          <line x1="260" y1="135" x2="340" y2="170" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5" marker-end="url(#arrowCyan2)"/>

          <!-- Agent 1 -->
          <rect x="10" y="170" width="100" height="45" rx="8" fill="rgb(6 182 212 / 0.15)" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5"/>
          <text x="60" y="190" text-anchor="middle" fill="rgb(6 182 212)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Research</text>
          <text x="60" y="202" text-anchor="middle" fill="rgb(6 182 212 / 0.7)" font-size="8" font-family="Inter, sans-serif">Agent</text>

          <!-- Agent 2 -->
          <rect x="150" y="170" width="100" height="45" rx="8" fill="rgb(6 182 212 / 0.15)" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5"/>
          <text x="200" y="190" text-anchor="middle" fill="rgb(6 182 212)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Analysis</text>
          <text x="200" y="202" text-anchor="middle" fill="rgb(6 182 212 / 0.7)" font-size="8" font-family="Inter, sans-serif">Agent</text>

          <!-- Agent 3 -->
          <rect x="290" y="170" width="100" height="45" rx="8" fill="rgb(6 182 212 / 0.15)" stroke="rgb(6 182 212 / 0.4)" stroke-width="1.5"/>
          <text x="340" y="190" text-anchor="middle" fill="rgb(6 182 212)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Action</text>
          <text x="340" y="202" text-anchor="middle" fill="rgb(6 182 212 / 0.7)" font-size="8" font-family="Inter, sans-serif">Agent</text>

          <!-- Arrows down -->
          <line x1="60" y1="215" x2="140" y2="245" stroke="rgb(16 185 129 / 0.4)" stroke-width="1.5" marker-end="url(#arrowGreen2)"/>
          <line x1="200" y1="215" x2="200" y2="245" stroke="rgb(16 185 129 / 0.4)" stroke-width="1.5" marker-end="url(#arrowGreen2)"/>
          <line x1="340" y1="215" x2="260" y2="245" stroke="rgb(16 185 129 / 0.4)" stroke-width="1.5" marker-end="url(#arrowGreen2)"/>

          <!-- Structured Output -->
          <rect x="120" y="245" width="160" height="30" rx="8" fill="rgb(16 185 129 / 0.15)" stroke="rgb(16 185 129 / 0.4)" stroke-width="1.5"/>
          <text x="200" y="264" text-anchor="middle" fill="rgb(16 185 129)" font-size="10" font-weight="600" font-family="Inter, sans-serif">Structured Output (Pydantic)</text>

          <defs>
            <marker id="arrowViolet2" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="rgb(139 92 246 / 0.6)"/></marker>
            <marker id="arrowCyan2" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="rgb(6 182 212 / 0.6)"/></marker>
            <marker id="arrowGreen2" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="rgb(16 185 129 / 0.6)"/></marker>
          </defs>
        </svg>
        </div>
      </div>
    </div>
  </div>
</section>
