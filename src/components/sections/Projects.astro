---
import SectionHeading from '../ui/SectionHeading.astro';
import { projects } from '../../data/projects';
---

<section id="projects" class="relative">
  <div class="absolute bottom-0 right-0 w-72 h-72 bg-cyan-500/5 rounded-full blur-3xl"></div>

  <div class="section-container relative z-10">
    <SectionHeading title="Featured Projects" subtitle="Hands-on work that showcases what I build" />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {projects.map((project, i) => (
        <div class={`card overflow-hidden group reveal delay-${(i + 1) * 100}`}>

          {/* Gradient header band */}
          <div class="h-48 relative overflow-hidden bg-gradient-to-br from-violet-600/20 via-cyan-600/10 to-transparent">
            <div class="absolute inset-0 hero-grid opacity-30"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <div class="w-16 h-16 mx-auto mb-3 rounded-2xl bg-gradient-to-br from-violet-500 to-cyan-500 flex items-center justify-center text-white shadow-lg">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                </div>
                <span class="text-sm font-medium text-violet-400">{project.tagline}</span>
              </div>
            </div>
          </div>

          {/* Content */}
          <div class="p-6 md:p-8">
            <h3 class="text-xl md:text-2xl font-bold mb-3" style="color: rgb(var(--color-text));">
              {project.title}
            </h3>
            <p class="text-sm leading-relaxed mb-5" style="color: rgb(var(--color-text-muted));">
              {project.description}
            </p>

            {/* Features */}
            <div class="mb-5">
              <h4 class="text-xs font-semibold uppercase tracking-wider mb-3 text-violet-400">Key Features</h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {project.features.map((f) => (
                  <div class="flex items-start gap-2 text-sm" style="color: rgb(var(--color-text-muted));">
                    <svg class="w-4 h-4 text-cyan-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {f}
                  </div>
                ))}
              </div>
            </div>

            {/* Impact */}
            <div class="p-4 rounded-xl mb-5" style="background-color: rgb(var(--color-bg-secondary));">
              <p class="text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-1">Impact</p>
              <p class="text-sm" style="color: rgb(var(--color-text-muted));">{project.impact}</p>
            </div>

            {/* Tech stack */}
            <div class="flex flex-wrap gap-1.5 mb-5">
              {project.technologies.map((tech) => (
                <span class="text-xs px-2.5 py-1 rounded-md font-medium bg-violet-500/10 text-violet-400 border border-violet-500/20">
                  {tech}
                </span>
              ))}
            </div>

            {/* Buttons */}
            <div class="flex items-center gap-3">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-medium border transition-all duration-200 hover:bg-violet-500/10 hover:border-violet-500/40"
                  style="border-color: rgb(var(--color-border)); color: rgb(var(--color-text-muted));"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                  GitHub
                </a>
              )}
              {project.demo && project.demo !== '#' && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2 rounded-lg text-sm font-medium bg-gradient-to-r from-violet-600 to-cyan-500 text-white shadow-lg hover:shadow-violet-500/30 hover:-translate-y-0.5 transition-all duration-300"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  Live Demo
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
