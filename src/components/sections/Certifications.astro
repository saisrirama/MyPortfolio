---
import SectionHeading from '../ui/SectionHeading.astro';
import { certifications } from '../../data/certifications';

const iconMap: Record<string, string> = {
  cloud: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>`,
  brain: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
  cpu: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>`,
  code: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
};

const gradients = [
  'from-violet-500 to-purple-600',
  'from-cyan-500 to-blue-600',
  'from-amber-500 to-orange-600',
  'from-emerald-500 to-teal-600',
];
---

<section id="certifications" class="relative">
  <div class="absolute top-0 right-0 w-64 h-64 bg-violet-500/5 rounded-full blur-3xl"></div>

  <div class="section-container relative z-10">
    <SectionHeading title="Certifications" subtitle="Professional credentials validating expertise" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {certifications.map((cert, i) => (
        <div class={`card p-6 md:p-8 group reveal delay-${(i + 1) * 100}`}>
          <div class="flex items-start gap-4">
            <div class={`w-14 h-14 shrink-0 rounded-2xl bg-gradient-to-br ${gradients[i % gradients.length]} flex items-center justify-center text-white shadow-lg group-hover:scale-110 transition-transform duration-300`}>
              <Fragment set:html={iconMap[cert.icon] || iconMap['code']} />
            </div>
            <div>
              <h3 class="text-base font-bold mb-1" style="color: rgb(var(--color-text));">
                {cert.title}
              </h3>
              <p class="text-xs font-medium text-violet-400 mb-2">{cert.issuer}</p>
              <p class="text-sm leading-relaxed" style="color: rgb(var(--color-text-muted));">
                {cert.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
