---
import SectionHeading from '../ui/SectionHeading.astro';
import { skillCategories } from '../../data/skills';

const iconMap: Record<string, string> = {
  Backend: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>`,
  Frontend: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  'AI & ML': `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
  'Cloud & DevOps': `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>`,
};
---

<section id="skills" class="relative">
  <div class="absolute top-1/2 left-0 w-64 h-64 bg-violet-500/5 rounded-full blur-3xl"></div>

  <div class="section-container relative z-10">
    <SectionHeading title="Skills" subtitle="Technologies and tools I work with" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {skillCategories.map((cat, i) => (
        <div class={`card p-6 md:p-8 reveal delay-${(i + 1) * 100}`}>
          <div class="flex items-center gap-3 mb-5">
            <div class={`w-10 h-10 rounded-xl flex items-center justify-center ${cat.bgColor}`}>
              <span class={cat.color}>
                <Fragment set:html={iconMap[cat.name] || ''} />
              </span>
            </div>
            <h3 class={`text-lg font-bold ${cat.color}`}>{cat.name}</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <span class={`skill-chip border ${cat.bgColor}`}>
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
